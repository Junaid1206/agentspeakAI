# FastAPI backend (copy to backend/.env)
DATABASE_URL=postgresql+asyncpg://agentspeak:agentspeak@localhost:5432/agentspeak
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_NAME=AgentSpeak AI

# OpenAI-compatible LLM. Leave blank to use deterministic fallback where supported.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8

# Browser demo is the default. Set telephony only after configuring Twilio.
CALL_MODE=browser
CALLING_PROVIDER=browser
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Browser-based voice demo uses Web Speech API and SpeechSynthesis.
STT_PROVIDER=browser
TTS_PROVIDER=browser
SILENCE_TIMEOUT_SECONDS=8
SILENCE_MAX_STRIKES=3
MAX_CONVERSATION_TURNS=40

# Next.js admin frontend (create frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
